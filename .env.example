# ─────────────────────────────────────────────
# ResumeAI backend — environment variables
# Copy this file to ".env" and fill in the values.
# NEVER commit your real .env file to GitHub.
# ─────────────────────────────────────────────

# AI provider API keys (only fill in the ones you plan to use).
# Keys are read on the server only and are never sent to the browser.
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Which provider to try first: claude | openai | gemini
# If the preferred provider's key is missing, the backend automatically
# falls back to any other provider that has a key configured.
AI_PROVIDER=claude

# Optional: override default models
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# Server
PORT=5000
FLASK_DEBUG=true
